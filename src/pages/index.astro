---
import Base from '../layouts/Base.astro';
import FlowChart from '../components/FlowChart.astro';
import SixWords from '../components/SixWords.astro';
import SlangTable from '../components/SlangTable.astro';
import { bookSegments, segmentMeta } from '../data/segments';
import { withBase } from '../utils/paths';
import { drama } from '../data/drama';
import { novel } from '../data/novel';

const books = ['yingyao', 'junma', 'zhafei', 'abao'].map((slug) => ({
  slug,
  ...segmentMeta[slug],
  count: bookSegments[slug].length,
}));

const lineage = [
  { who: '方照舆', when: '康熙年间', what: '洪门五祖之一，被奉为祖师。以相命先生身份行走江湖，掩护反清活动。', role: '祖师（追认）' },
  { who: '张雪庵', when: '清末', what: '号「玄机子」，广东文帮诈骗集团公推的教主。租下顺德无人敢住的「鬼屋」布下十年之局，连目标身上的朱砂痣都能说出。', role: '教主' },
  { who: '何立庭', when: '1845–1928', what: '张雪庵的嫡传弟子。新会人，迁往香港荷李活道营业，兼营鸦片烟馆。两广相连的枢纽人物。', role: '掌门' },
  { who: '李星南', when: '民国', what: '以「道术种金」著名，善用女色，最终被香港当局通缉（或被捕入狱）。', role: '弟子' },
  { who: '傅吉臣', when: '民国', what: '因用「扎飞」手段骗他人之妾为己妾，违反门规，同门拒绝其继任掌门。江相派由此断裂。', role: '弟子（失位）' },
];
---

<Base
  title="江相派 · 江湖上的宰相"
  description="江相派是什么：晚清民初活跃于广东的诈骗集团，以看相算命为途径做局诈骗。四本秘本原文逐段注解，七步流水线、六字真言、江湖黑话交互式拆解。易之纪实小说《我是个算命先生》与电视剧《我不是大师》均取材于这一真实江湖组织。"
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-kicker">骗局解剖 · 非命理</div>
      <h1>江湖上的宰相</h1>
      <p>
        一个经营了两百年的诈骗集团留下的完整操作手册。
        这里没有命理，只有流程、话术、仪式，和它们为什么至今仍然有效。
      </p>
      <div class="hero-meta">
        <span>晚清至民国初年</span>
        <span>大本营广州</span>
        <span>粤语语系范围</span>
      </div>
      <div class="hero-jump">
        <a href="#books">四本秘本原文</a>
        <a href="#flow">七步流水线</a>
        <a href="#six">六字真言</a>
        <a href="#slang">江湖黑话</a>
        <a href="#lineage">掌门谱系</a>
      </div>
    </div>
  </section>

  <section class="band" id="books">
    <div class="wrap">
      <p class="band-kicker">四本秘本 · 原文逐段注解</p>
      <h2>不是相书，是骗术手册</h2>
      <p class="band-lede">
        「江相派的四本书」常被误解为《麻衣神相》一类的相学著作。
        实际流传下来的是四本专门用于行骗的秘本——共 <strong>122 段</strong>原文，
        这里逐段对照注解，没有摘要、没有节选。
      </p>

      <ul class="book-grid">
        {books.map((b) => (
          <li>
            <a class="book-card" href={withBase(b.slug + '/')}>
              <div class="book-card-top">
                <span class="book-role">{b.role}</span>
                <span class="book-count">{b.count} 段</span>
              </div>
              <h3>{b.title}</h3>
              <p class="book-rom">{b.romanization}</p>
              <p class="book-desc">{b.nature}</p>
              <span class="book-go">读原文与注解 →</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="callout">
        <div class="callout-title">一处关键发现：军马篇是填空模板</div>
        <p>
          军马篇的田宅、财帛、迁徒、官禄诸宫，原文写着
          「田宅带<strong>××</strong>（<strong>任何星均可套入</strong>）」、
          「出外<strong>×方</strong>（<strong>东南西北均可</strong>）」。
          换星名、换方向，句子结构完全不变。
        </p>
        <p>
          <strong>这意味着它可以生成无穷多"不同的"断语，而底层结构完全相同。</strong>
          骗术师把巴纳姆效应做成了可批量生产的模板——这是整个体系里最要紧的一条技术说明，
          而且是原文自己写明的。
        </p>
      </div>

      <div class="note">
        <strong>史料分歧：</strong>
        维基百科《江相派》词条并列四篇为「法术经典」，同时又称「师门三宝」指英耀、扎飞、阿宝，将军马篇另列。
        另一说认为军马篇本就是英耀篇的配对附录。
        各来源对文本内容的描述基本一致，分歧只在于归类。本站采用四篇并列说，并保留分歧记录。
      </div>
    </div>
  </section>

  <section class="band band-alt" id="flow">
    <div class="wrap">
      <p class="band-kicker">行骗流程 · 点开每一步</p>
      <h2>七步流水线</h2>
      <p class="band-lede">
        从锁定目标到脱身，江相派的作业流程与今日的电信诈骗高度相似。
        点开任意一步看细节。
      </p>
      <FlowChart />
    </div>
  </section>

  <section class="band" id="six">
    <div class="wrap">
      <p class="band-kicker">《英耀篇》核心 · 点开每个字</p>
      <h2>六字真言</h2>
      <p class="band-lede">
        <code>敲</code> <code>打</code> <code>审</code> <code>千</code> <code>隆</code> <code>卖</code>
        ——江相派唯一以「真传」名义传授的原理总纲。
        原文说：「无千不响，无隆不成。」这六个字至今有效。
      </p>
      <SixWords />
    </div>
  </section>

  <section class="band band-alt" id="slang">
    <div class="wrap">
      <p class="band-kicker">可检索 · 共 60 余条</p>
      <h2>江湖黑话</h2>
      <p class="band-lede">
        秘本全篇以黑话写成，为的是防泄密——外人读来如读天书。
        这里把它们整理出来，可以搜。
      </p>
      <SlangTable />
    </div>
  </section>

  <section class="band" id="lineage">
    <div class="wrap">
      <p class="band-kicker">可考的传承</p>
      <h2>掌门谱系</h2>
      <p class="band-lede">
        江相派留下了一条少数有史料支撑的谱系。
        它同时也是一份消亡原因说明书。
      </p>
      <ol class="lineage">
        {lineage.map((p) => (
          <li class="lin">
            <div class="lin-when">{p.when}</div>
            <div class="lin-body">
              <h3>{p.who}<span class="lin-role">{p.role}</span></h3>
              <p>{p.what}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="callout">
        <div class="callout-title">它是怎么消亡的</div>
        <p>
          不是被取缔，也不是被科学证伪——而是<strong>它赖以生存的生态消失了</strong>。
          傅吉臣因违反门规失去继任资格，而更根本的原因是：香港法治转好，
          「同行不需要互相保护或与其他帮派谈判」了。
        </p>
        <p>
          江相派要求受害者「有所畏怯而不敢言」，靠的是正规渠道不可信这个前提。
          当报警真的有用，这套体系的地基就没了。<strong>它不是被破除的，是被竞争的。</strong>
        </p>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="psych">
    <div class="wrap">
      <p class="band-kicker">为什么它有效</p>
      <h2>这不是魔法，是认知偏差</h2>
      <p class="band-lede">
        这套流程里没有一步是「预测」。
        回看七步：筛选目标、建立信任、收集信息、制造恐惧、导向仪式、长期榨取、撤离——
        <strong>没有一步在获取目标的真实命运。</strong>
        所有的「神准」都是信息回流的错觉。
      </p>

      <ul class="mech-grid">
        <li>
          <h3>巴纳姆效应</h3>
          <p>「志大才疏，空把恨」这类断语对绝大多数人都成立。1948 年福勒实验：全班发同一份分析，平均准确度 4.26/5。</p>
        </li>
        <li>
          <h3>冷读术</h3>
          <p>从衣着、口吻、眼神做结构化外推。信息其实来自目标自己，只是被复述回来后归因错了。</p>
        </li>
        <li>
          <h3>恐惧激活</h3>
          <p>「非有所惧，即有所求」——没有恐惧和需求，人不会停留。恐惧一旦激活，人会放弃独立判断。</p>
        </li>
        <li>
          <h3>承诺一致性</h3>
          <p>烧香、写下生辰八字、付第一笔钱。仪式的作用是让人跨过「我是不是被骗了」这个念头。</p>
        </li>
        <li>
          <h3>信息级联</h3>
          <p>「小验然后大响，众信然后大成。」一旦有旁人证实灵验，后续验证成本几乎归零。</p>
        </li>
        <li>
          <h3>自我实现</h3>
          <p>「你今年容易破财」→焦虑→决策保守→真的错失机会。不是命运，是他自己帮它实现的。</p>
        </li>
      </ul>

      <p style="margin-top:32px">
        <a class="more-link" href={withBase('mechanism/')}>展开阅读：为什么会相信 · 完整机制与原文对照 →</a>
      </p>
    </div>
  </section>

  <section class="band" id="drama">
    <div class="wrap">
      <p class="band-kicker">秘本 → 小说 → 电视剧</p>
      <h2>从「江相派」到《我不是大师》</h2>
      <p class="band-lede">
        这二十年里，江相派先被写进小说，再被搬上屏幕。
        <strong>本站收录的是最前面那一层——秘本原文。</strong>
      </p>

      <div class="chain">
        <div class="chain-step">
          <div class="chain-when">民国 · 流传</div>
          <div class="chain-what">师门秘本</div>
          <div class="chain-desc">《英耀》《扎飞》《阿宝》三篇口诀，不外传。这是本站收录的部分。</div>
        </div>
        <div class="chain-step">
          <div class="chain-when">{novel.published.slice(0, 4)} · 出版</div>
          <div class="chain-what">小说《{novel.title}》</div>
          <div class="chain-desc">易之著，{novel.publisher}。纪实小说，写算命行当的门道。</div>
        </div>
        <div class="chain-step">
          <div class="chain-when">{drama.premiered.slice(0, 4)} 年 {Number(drama.premiered.slice(5, 7))} 月 · 上线</div>
          <div class="chain-what">电视剧《{drama.title}》</div>
          <div class="chain-desc">{drama.director}执导，李现、李一桐主演。{drama.platforms.join(' / ')}。</div>
        </div>
      </div>

      <div class="drama-grid">
        <div class="drama-card">
          <div class="drama-k">原著小说</div>
          <p class="novel-lead">
            《{novel.title}》，{novel.author}著，{novel.published.slice(0, 4)} 年由{novel.publisher}出版，
            读客·知识小说文库。豆瓣 <strong>{novel.doubanScore}</strong> 分。
          </p>
          <p>
            这不是纯虚构。作者从江相派传人口述取材，写的是民国年间算命行当的真实猫腻。
            书中主角「祖爷」是江相派掌门人——<strong>电视剧里的天相派首领，原型就是他</strong>。
          </p>
          <p class="novel-epi">
            原著开篇没有从故事写起，而是先摆了一句《阿宝篇》：
          </p>
          <blockquote class="drama-epi">{novel.epigraph}</blockquote>
          <p class="drama-note">
            <strong>但小说不是史料。</strong>
            本站秘本原文另有来源——公开流传的抄本与百科条目记载，
            不是从小说里摘录的。<a href={withBase('manuscripts/')}>来源说明 →</a>
          </p>
        </div>

        <div class="drama-card">
          <div class="drama-k">电视剧</div>
          <p class="novel-lead">
            《{drama.title}》，改编自{novel.author}的《{novel.title}》。
            {drama.premiered} 起在{drama.platforms.join('、')}播出，共 {drama.episodes} 集。
          </p>
          <p>
            剧里的反派组织叫「天相派」——为避讳，「江相派」三字被换掉了，
            但原型就是它。故事讲李现饰演的上官诚明被算命做局灭门，
            拜师学艺后一路以骗反骗。
          </p>
          <dl class="drama-cast">
            <dt>导演</dt><dd>{drama.director}</dd>
            <dt>编剧</dt><dd>{drama.writer}</dd>
            <dt>原著</dt><dd>{novel.title} · {novel.author}</dd>
          </dl>
          <div class="drama-k drama-k-2">主要演员</div>
          <ul class="drama-roles">
            {drama.cast.map((c) => (
              <li><strong>{c.actor}</strong><span>{c.role}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="drama-grid drama-grid-2">
        <div class="drama-card">
          <div class="drama-k">原著里已经写到的</div>
          <ul class="overlap-list">
            {novel.overlaps.map((o) => (
              <li><strong>{o.key}</strong><span>{o.note}</span></li>
            ))}
          </ul>
          <p class="drama-note" style="margin-top:16px">
            如果你是从书或剧入坑，这几篇就是源头。<a href={withBase('manuscripts/')}>四篇总览 →</a>
          </p>
        </div>

        <div class="drama-card">
          <div class="drama-k">接着往下读</div>
          <div class="drama-links">
            {drama.links.map((l) => (
              <a href={withBase(l.href)}>{l.label}<span>{l.note}</span></a>
            ))}
          </div>
        </div>
      </div>

      <div class="callout">
        <div class="callout-title">三层之间最值得对照的一点</div>
        <p>
          小说和剧都按「复仇」写——好人被害、拜师学艺、以骗反诈。
          但秘本里记的是另一件事：<strong>让受害者「有所畏怯而不敢言」</strong>。
          恐吓人只是手段，让受害者不敢报警、不敢说出口，才是整套体系能延续的地基。
        </p>
        <p>
          这一条在小说和剧里都有影子，但都只是情节。
          <strong>只有秘本把它当成必须做到的原则写下来了</strong>——
          「取之不竭其力，不伤其根，上顺天理，下快人心，并使之有所畏怯而不敢言。」
        </p>
      </div>
    </div>
  </section>

  <section class="band band-end">
    <div class="wrap">
      <blockquote class="big-quote">
        <p>神鬼无凭，唯人是依。</p>
        <cite>——《扎飞篇》</cite>
      </blockquote>
      <p class="quote-note">
        这句话出自骗子之口，而且是整篇里最诚实的一句。
        骗子不指望鬼神，指望人——指望从众、指望恐惧、指望你不会说出去。
      </p>
    </div>
  </section>
</Base>
