---
import Base from '../layouts/Base.astro';
import { bookSegments, segmentMeta, bookOrder, subParts } from '../data/segments';

export function getStaticPaths() {
  return Object.keys(segmentMeta).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const meta = segmentMeta[slug];
const segments = bookSegments[slug];
const i = bookOrder.indexOf(slug);
const prevSlug = bookOrder[i - 1];
const nextSlug = bookOrder[i + 1];

// 按 tag 分组，保留原始顺序
const groups: { tag: string; items: typeof segments }[] = [];
for (const s of segments) {
  const t = s.tag ?? '正文';
  let g = groups.find((x) => x.tag === t);
  if (!g) {
    g = { tag: t, items: [] };
    groups.push(g);
  }
  g.items.push(s);
}
---

<Base
  title={`${meta.title} 原文与注解 · 江相派`}
  description={`${meta.title}（${meta.romanization}）全文 ${segments.length} 段，逐段原文、译文与注解。江相派四本秘本之一，${meta.nature}。`}
  ogType="article"
  book={{ name: meta.title, alternateName: meta.romanization }}
>
  <div class="ms-head">
    <div class="wrap-wide">
      <p class="part-label">四本秘本 · {meta.role}</p>
      <div class="ms-head-row">
        <h1>{meta.title}</h1>
        <span class="ms-nature">{meta.nature}</span>
      </div>
      <p class="ms-rom">{meta.romanization} · 全文 {segments.length} 段</p>
    </div>
  </div>

  <div class="reader">
    <aside class="rd-side">
      <div class="rd-side-inner">
        <div class="rd-side-title">目录</div>
        {groups.map((g, gi) => (
          <div class="rd-group">
            <a class="rd-group-title" href={`#g-${gi}`}>{g.tag}</a>
            <ol>
              {g.items.map((s) => (
                <li><a href={`#seg-${s.no}`}>{s.no}</a></li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </aside>

    <div class="rd-flow">
      {groups.map((g, gi) => (
        <>
          <h2 class="rd-sec-title" id={`g-${gi}`}>
            <span>{g.tag}</span>
            <span class="rd-sec-count">{g.items.length} 段</span>
          </h2>
          {g.items.map((s) => (
            <>
              <div class="rd-no" id={`seg-${s.no}`}>{String(s.no).padStart(2, '0')}</div>
              <div class="rd-orig">
                <blockquote class="rd-text">{s.text}</blockquote>
                {s.trans && (
                  <p class="rd-trans">
                    <span class="rd-trans-label">译文</span>
                    {s.trans}
                  </p>
                )}
              </div>
              <div class="rd-note">
                <span class="rd-note-label">注解</span>
                <p set:html={s.note.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
              </div>
            </>
          ))}
        </>
      ))}

      <div class="pager">
        {prevSlug ? (
          <a href={`/${prevSlug}/`}><span>← 上一篇</span>{segmentMeta[prevSlug].title}</a>
        ) : <span></span>}
        {nextSlug ? (
          <a href={`/${nextSlug}/`} style="text-align:right"><span>下一篇 →</span>{segmentMeta[nextSlug].title}</a>
        ) : (
          <a href="/manuscripts/" style="text-align:right"><span>全部 →</span>四本秘本总览</a>
        )}
      </div>
    </div>
  </div>
</Base>
