---
import Base from '../layouts/Base.astro';
import { bookSegments, segmentMeta, bookOrder, subParts } from '../data/segments';

export function getStaticPaths() {
  return Object.keys(segmentMeta).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const meta = segmentMeta[slug];
const segments = bookSegments[slug];
const i = bookOrder.indexOf(slug);
const prevSlug = bookOrder[i - 1];
const nextSlug = bookOrder[i + 1];
const parts = subParts[slug] ?? [];
const tags = [...new Set(segments.map((s) => s.tag).filter(Boolean))] as string[];
---

<Base title={`${meta.title} 原文与注解 · 江相派`} description={`${meta.title}（${meta.romanization}）全文 ${segments.length} 段，逐段原文与注解。`}>
  <div class="ms-head">
    <div class="wrap">
      <p class="part-label">四本秘本 · {meta.role}</p>
      <div class="ms-head-row">
        <h1>{meta.title}</h1>
        <span class="ms-nature">{meta.nature}</span>
      </div>
      <p class="ms-rom">{meta.romanization} · 全文 {segments.length} 段</p>
      {parts.length > 0 && (
        <nav class="part-nav">
          {parts.map((p) => {
            const first = segments.find((s) => s.tag === p);
            return first ? <a href={`#seg-${first.no}`}>{p}</a> : null;
          })}
        </nav>
      )}
    </div>
  </div>

  <article class="ms-body">
    <div class="wrap">
      <ol class="seg-list">
        {segments.map((s) => (
          <li class="seg" id={`seg-${s.no}`}>
            <div class="seg-no">{String(s.no).padStart(2, '0')}</div>
            <div class="seg-main">
              <blockquote class="seg-text">{s.text}</blockquote>
              {s.tag && <span class="seg-tag">{s.tag}</span>}
              <div class="seg-note">
                <span class="seg-note-label">注解</span>
                <p set:html={s.note.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="pager">
        {prevSlug ? (
          <a href={`/${prevSlug}/`}><span>← 上一篇</span>{segmentMeta[prevSlug].title}</a>
        ) : <span></span>}
        {nextSlug ? (
          <a href={`/${nextSlug}/`} style="text-align:right"><span>下一篇 →</span>{segmentMeta[nextSlug].title}</a>
        ) : (
          <a href="/manuscripts/" style="text-align:right"><span>全部 →</span>四本秘本总览</a>
        )}
      </div>
    </div>
  </article>
</Base>
