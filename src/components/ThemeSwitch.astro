---
const GITHUB_URL = 'https://github.com/readlab-x/jiangxiang-school';
---

<div class="head-tools">
  <div class="theme-group" role="group" aria-label="主题选择">
    <button type="button" class="theme-btn" data-theme-choice="light" aria-pressed="false" title="亮色" aria-label="使用亮色主题">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="3.6" />
        <path d="M10 2.4v1.8M10 15.8v1.8M2.4 10h1.8M15.8 10h1.8M4.6 4.6l1.3 1.3M14.1 14.1l1.3 1.3M15.4 4.6l-1.3 1.3M5.9 14.1l-1.3 1.3" />
      </svg>
    </button>
    <button type="button" class="theme-btn" data-theme-choice="dark" aria-pressed="false" title="暗色" aria-label="使用暗色主题">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M16.2 12.4A6.8 6.8 0 0 1 7.6 3.8a6.9 6.9 0 1 0 8.6 8.6z" />
      </svg>
    </button>
    <button type="button" class="theme-btn" data-theme-choice="system" aria-pressed="false" title="跟随系统" aria-label="跟随系统主题">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <rect x="2.2" y="3.4" width="15.6" height="10.4" rx="1.6" />
        <path d="M7 16.6h6" />
      </svg>
    </button>
  </div>

  <a class="gh-btn" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" title="GitHub 仓库" aria-label="在 GitHub 上查看仓库">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
    </svg>
  </a>
</div>

<style>
  .head-tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .theme-group {
    display: flex;
    align-items: center;
    gap: 2px;
    background: var(--paper);
    border: 0.5px solid var(--line);
    border-radius: 8px;
    padding: 3px;
  }

  .theme-btn,
  .gh-btn {
    display: grid;
    place-items: center;
    border: none;
    cursor: pointer;
    transition: color 0.12s, background 0.12s;
  }

  .theme-btn {
    width: 26px;
    height: 24px;
    border-radius: 5px;
    padding: 0;
    background: var(--paper);
    color: var(--btn-ink);
  }
  .theme-group .theme-btn:first-child { border-radius: 5px 2px 2px 5px; }
  .theme-group .theme-btn:last-child { border-radius: 2px 5px 5px 2px; }

  .theme-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-btn[data-theme-choice='light'] svg { fill: currentColor; stroke-width: 1.1; }

  .theme-btn:hover,
  .gh-btn:hover { color: var(--ink); }

  /* 选中项凸出：底色回到导航栏色，与凹陷的未选中项形成明暗差 */
  .theme-btn[data-active='true'] {
    background: var(--head-bg);
    color: var(--accent);
  }

  .gh-btn {
    width: 30px;
    height: 31px;
    border-radius: 7px;
    background: var(--head-bg);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }
  .gh-btn:hover { color: var(--ink); border-color: var(--ink-faint); }
  .gh-btn svg { width: 16px; height: 16px; fill: currentColor; }
</style>
