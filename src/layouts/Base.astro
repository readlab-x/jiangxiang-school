---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/reader.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { themeBootstrap } from '../scripts/theme';
import { withBase } from '../utils/paths';
import { drama } from '../data/drama';
import { novel } from '../data/novel';

interface Props {
  title: string;
  description: string;
  /** 页面类型，默认 website */
  ogType?: string;
  /** 是否为四本秘本之一（用于结构化数据标记） */
  book?: { name: string; alternateName: string };
}

const { title, description, ogType = 'website', book } = Astro.props;

const SITE = '江相派';
// Astro.url.pathname 构建时已含 base（/jiangxiang-school/...），
// 所以这里用站点根域，new URL() 才能拼出完整绝对地址
const ORIGIN = 'https://readlab-x.github.io';
const canonical = new URL(Astro.url.pathname, ORIGIN).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, ORIGIN).href;
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-theme-pref="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- 图标 -->
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171a" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE} · 江湖上的宰相`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline set:html={themeBootstrap} />

    {book && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Book',
        name: book.name,
        alternateName: book.alternateName,
        inLanguage: 'zh-CN',
        description,
        url: canonical,
        isPartOf: { '@type': 'WebSite', name: SITE, url: ORIGIN },
      })} />
    )}

    <!-- 原著小说：与 TVSeries 关联，构成「秘本 → 小说 → 电视剧」的完整链路 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Book',
      name: novel.title,
      author: { '@type': 'Person', name: novel.author },
      inLanguage: 'zh-CN',
      bookFormat: novel.producer,
      isbn: novel.isbn,
      numberOfPages: novel.pages,
      datePublished: novel.published,
      publisher: { '@type': 'Organization', name: novel.publisher },
      genre: '纪实小说',
      inSeries: { '@type': 'BookSeries', name: novel.series },
      url: canonical,
      description: `${novel.author}所著纪实小说，${novel.published.slice(0, 4)}年${novel.publisher}出版。以民国江相派掌门「祖爷」为主角，记述算命行当的真实猫腻，非史料。电视剧《${drama.title}》改编自本书。`,
    })} />

    <!-- 影视改编关联：把本站与该剧挂上关系，读者从剧搜到史，也能认出来源是史实原文 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TVSeries',
      name: drama.title,
      alternateName: drama.aliases,
      inLanguage: 'zh-CN',
      description: `${drama.title}（${drama.premiered} 播出，${drama.platforms.join('、')}）改编自${drama.novel.author}小说《${drama.novel.title}》，取材于真实历史江湖组织江相派，剧中化名为「天相派」。本页面提供该组织的历史秘本原文与逐段注解。`,
      startDate: drama.premiered,
      numberOfEpisodes: drama.episodes,
      director: [{ '@type': 'Person', name: drama.director }],
      writer: [{ '@type': 'Person', name: drama.writer }],
      actor: drama.cast.map((c) => ({ '@type': 'Person', name: c.actor })),
      basedOn: { '@type': 'Book', name: drama.novel.title, author: { '@type': 'Person', name: drama.novel.author } },
      productionCompany: [{ '@type': 'Organization', name: '青岛老友影视文化传媒有限公司' }],
      url: canonical,
      about: { '@type': 'Thing', name: '江相派', description: '晚清民初活跃于广东的诈骗集团，以算命为途径做局' },
    })} />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href={withBase()}>{SITE}</a>
        <nav class="site-nav">
          <a href={withBase()}>介绍</a>
          <a href={withBase('yingyao/')}>英耀篇</a>
          <a href={withBase('junma/')}>军马篇</a>
          <a href={withBase('zhafei/')}>扎飞篇</a>
          <a href={withBase('abao/')}>阿宝篇</a>
          <a href={withBase('mechanism/')}>骗局机制</a>
        </nav>
        <div class="head-right">
          <ThemeSwitch />
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <strong>关于本站</strong>
        本站是一个关于江相派的历史与机制科普项目。江相派是晚清民初活跃于广东一带的诈骗集团，
        本站整理其组织结构、行骗流程与四本秘本，并从心理学角度解释其运作原理，
        以便读者理解这类骗局在今天为何仍然有效。<br />
        站内所引秘本原文均来自公开流传的转载版本，非正式出版物，异文难以尽校，引用时已尽量标注来源。
      </div>
    </footer>

    <script is:inline>
      (function () {
        var key = 'jiangxiang-theme';
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');

        var apply = function (pref) {
          var dark = pref === 'dark' || (pref === 'system' && media.matches);
          root.dataset.theme = dark ? 'dark' : 'light';
          root.dataset.themePref = pref;
          document.querySelectorAll('[data-theme-choice]').forEach(function (b) {
            var on = b.dataset.themeChoice === pref;
            b.dataset.active = String(on);
            b.setAttribute('aria-pressed', String(on));
          });
        };

        var stored;
        try {
          stored = localStorage.getItem(key);
        } catch (e) {}
        apply(stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system');

        document.querySelectorAll('[data-theme-choice]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var pref = btn.dataset.themeChoice;
            try {
              localStorage.setItem(key, pref);
            } catch (e) {}
            apply(pref);
          });
        });

        media.addEventListener('change', function () {
          var pref = root.dataset.themePref;
          if (!pref || pref === 'system') apply('system');
        });
      })();
    </script>
  </body>
</html>
